{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\""
          },
          {
            "type": "command",
            "if": "Bash(docker *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\""
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\""
          }
        ]
      }
    ]
  }
}
